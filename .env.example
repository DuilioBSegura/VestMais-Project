# ==============================================================================
# Vest+ - Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env na raiz do projeto e ajuste as credenciais.
# cp .env.example .env
# ==============================================================================

# Porta HTTP exposta no host VPS pelo serviço app do Docker Compose
APP_PORT=8080

# Ambiente da aplicação ('production' ou 'development')
APP_ENV=production

# Configurações de Conexão com o Banco de Dados (MariaDB)
# No Docker Compose, o hostname do banco é o próprio nome do serviço ('db')
DB_HOST=db
DB_PORT=3306
DB_NAME=vestplus
DB_USER=vestuser
DB_PASS=senha_forte_aqui
DB_CHARSET=utf8mb4

# Senha do usuário administrativo (root) do MariaDB (usada na inicialização e backups)
DB_ROOT_PASS=root_senha_segura_vestmais
