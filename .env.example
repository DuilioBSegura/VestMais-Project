# ==============================================================================
# Vest+ Platform - Arquivo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env na raiz do projeto e ajuste as credenciais:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
APP_NAME="Vest+"
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Conexão com o Banco de Dados (MariaDB no Docker Compose)
# ------------------------------------------------------------------------------
# Em ambiente Docker, utilize DB_HOST=db (nome do serviço na rede vestmais_net).
# Para desenvolvimento local sem Docker (XAMPP), utilize DB_HOST=127.0.0.1.
DB_HOST=db
DB_PORT=3306
DB_NAME=vestplus
DB_USER=vestuser
DB_PASS=senha_forte_aqui
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# Credenciais Administrativas do Container MariaDB
# ------------------------------------------------------------------------------
# Senha de superusuário 'root' usada internamente pelo serviço 'db' no docker-compose.
MYSQL_ROOT_PASSWORD=super_root_password_segura
